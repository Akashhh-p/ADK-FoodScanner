<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    tools:context=".ui.home.HomeActivity">

    <!-- Top Bar with Logout -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="@color/purple_500">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/welcomeMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/welcome"
                android:textSize="14sp"
                android:textColor="@color/white"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/logoutButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:text="@string/logout"
            android:textColor="@color/purple_500"
            app:backgroundTint="@color/white"
            android:padding="12dp" />

    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Scan Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/scanButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/scan_product"
                android:textSize="18sp"
                android:padding="20dp"
                app:cornerRadius="12dp"
                android:layout_marginBottom="32dp"
                android:backgroundTint="@color/purple_500" />

            <!-- Recent Scans Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/recent_scans"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Recent Scans RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recentScansRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                tools:listitem="@layout/item_scan_history" />

            <!-- No Scans Message -->
            <TextView
                android:id="@+id/noScansMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_scans"
                android:textSize="14sp"
                android:gravity="center"
                android:textColor="@color/gray_500"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

            <!-- View All History Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/viewHistoryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/view_history"
                android:textSize="16sp"
                android:padding="16dp"
                app:cornerRadius="8dp"
                android:visibility="gone"
                app:backgroundTint="@color/teal_700" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
